{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "publication_slug",
    "visual_index",
    "role",
    "sourceUrl",
    "rights"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "publication_slug": {
      "type": "string",
      "minLength": 1
    },
    "visual_index": {
      "type": "integer",
      "minimum": 0
    },
    "role": {
      "enum": [
        "framework",
        "result",
        "device",
        "table"
      ]
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "rights": {
      "type": "object",
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "verified",
            "not-reusable"
          ]
        },
        "evidence": {
          "type": "array"
        }
      }
    },
    "naturalSize": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "readability": {
      "enum": [
        "wide",
        "balanced",
        "portrait"
      ]
    },
    "explanation": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "object",
          "required": [
            "information",
            "relationship",
            "sourceUrl"
          ],
          "properties": {
            "information": {
              "type": "object",
              "required": [
                "field"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "pattern": "^visuals\\.[0-9]+\\.(caption|insight)$"
                }
              }
            },
            "relationship": {
              "type": "object",
              "required": [
                "field"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "pattern": "^visuals\\.[0-9]+\\.(caption|insight)$"
                }
              }
            }
          }
        },
        "en": {
          "type": "object",
          "required": [
            "information",
            "relationship",
            "sourceUrl"
          ],
          "properties": {
            "information": {
              "type": "object",
              "required": [
                "field"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "pattern": "^visuals\\.[0-9]+\\.(caption|insight)$"
                }
              }
            },
            "relationship": {
              "type": "object",
              "required": [
                "field"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "pattern": "^visuals\\.[0-9]+\\.(caption|insight)$"
                }
              }
            }
          }
        }
      }
    },
    "layoutHint": {
      "enum": [
        "stack",
        "split"
      ]
    }
  }
}
