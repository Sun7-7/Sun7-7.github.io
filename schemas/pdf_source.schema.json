{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paperId",
    "landingUrl",
    "localPdfPath",
    "remotePdfUrl",
    "externalPdfUrl",
    "version",
    "licenseEvidence",
    "reviewStatus",
    "mayPublishLocal",
    "sha256"
  ],
  "properties": {
    "paperId": {
      "type": "string",
      "minLength": 3
    },
    "landingUrl": {
      "type": "string",
      "format": "uri"
    },
    "localPdfPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "remotePdfUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "externalPdfUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "version": {
      "enum": [
        "published",
        "accepted_manuscript",
        "preprint"
      ]
    },
    "licenseEvidence": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "reviewStatus": {
      "enum": [
        "local_verified",
        "remote_verified",
        "official_source_only"
      ]
    },
    "mayPublishLocal": {
      "type": "boolean"
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
